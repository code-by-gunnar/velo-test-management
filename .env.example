# Docker Compose stack configuration — copy to .env and fill the secrets.
# Bare infra (docker compose up -d) needs none of these; the app overlay
# (docker-compose.app.yml) hard-fails on the three marked REQUIRED.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=velo
POSTGRES_PASSWORD=velo            # change for any non-local deployment
POSTGRES_DB=velo_dev

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public origin of the web app (Auth.js origin + API CORS allow-list)
WEB_URL=http://localhost:3000
# Browser-facing API URL (SSE EventSource + docs display). Baked into the web
# image at build time — changing it requires an image rebuild.
PUBLIC_API_URL=http://localhost:3001

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
APP_DB_PASSWORD=                  # non-superuser velo_app role (RLS enforcement). Servers: openssl rand -hex 16.
                                  # Local dev machines: use 'velo_app' — the vitest harness provisions the same
                                  # cluster-wide role with that password (apps/api/src/test/global-setup.ts).
AUTH_SECRET=                      # openssl rand -base64 32 — shared web+api (api decrypts Auth.js JWE)
INTERNAL_API_SECRET=              # openssl rand -hex 32 — web→api server-to-server auth
# ── Email (OPTIONAL) ─────────────────────────────────────────────────────────
# No SMTP configured = console mode: OTPs/reset links print to `docker compose
# logs api`, and invite links appear in the members UI for copy-paste.
# Any SMTP works: Gmail app password, SES, Mailgun, smtp.resend.com, ...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                   # 465 switches to implicit TLS automatically
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=Velo <velo@yourdomain>
# SUPPORT_EMAIL=                  # reply-to on the welcome email

# ── Optional ─────────────────────────────────────────────────────────────────
# API_NODE_ENV=development        # dev-mode api: OTPs to stdout, 100% Sentry traces
# ENCRYPTION_KEY=                 # openssl rand -hex 32 (64 hex chars) — REQUIRED for Linear (encrypts the API key at rest)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# AI spec-to-test import — provider chosen per workspace in the UI (Settings → Integrations).
# These are instance-wide fallbacks used when a workspace hasn't set its own key.
# ANTHROPIC_API_KEY=              # Claude (default provider)
# OPENAI_API_KEY=                 # OpenAI (gpt-4o)

# ── Optional observability (bring your own — OFF by default) ──────────────────
# Self-hosted instances phone home to NOTHING unless you set these. Point them at
# YOUR OWN Sentry/PostHog — leaving them empty disables error tracking + analytics.
# SENTRY_DSN=                     # one project for api (runtime) AND web (build ARG). Empty = off. Changing it needs a web image rebuild.
# POSTHOG_KEY=                    # server-side product analytics. Empty = off.
# POSTHOG_HOST=https://eu.i.posthog.com
# Linear connects via a personal API key entered in the UI (Settings > Integrations) —
# set ENCRYPTION_KEY above and nothing else is needed. LINEAR_CLIENT_ID/SECRET are only
# for the legacy OAuth flow (needs a public browser-reachable callback; unused self-hosted).
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# AUTH_GOOGLE_ID=                 # OAuth — register callback {WEB_URL}/api/auth/callback/google
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=                 # OAuth — register callback {WEB_URL}/api/auth/callback/github
# AUTH_GITHUB_SECRET=
