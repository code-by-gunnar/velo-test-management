{
  "name": "velo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter=@velo/api --filter=@velo/web dev",
    "build": "pnpm --filter=@velo/api --filter=@velo/web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "stack:up": "docker compose -f docker-compose.yml -f docker-compose.app.yml up -d --build",
    "stack:down": "docker compose -f docker-compose.yml -f docker-compose.app.yml down",
    "stack:logs": "docker compose -f docker-compose.yml -f docker-compose.app.yml logs -f api"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {},
  "pnpm": {
    "comment": "Security-only overrides (VEL-65). Version-scoped to stay within each dependency's current major so backward compatibility is preserved; verified with full build + test.",
    "overrides": {
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "ws": ">=8.21.1",
      "picomatch": ">=4.0.5",
      "postcss": ">=8.5.20",
      "@opentelemetry/core": ">=2.9.0",
      "lodash": ">=4.18.1",
      "brace-expansion@2": "2.1.2",
      "brace-expansion@5": "5.0.7",
      "uuid@^11": "^11.1.1"
    }
  }
}
