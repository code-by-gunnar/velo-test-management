{
  "name": "velo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter=@velo/api --filter=@velo/web dev",
    "build": "pnpm --filter='./packages/*' build && pnpm --filter='./apps/*' build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "stack:up": "docker compose -f docker-compose.yml -f docker-compose.app.yml up -d --build",
    "stack:down": "docker compose -f docker-compose.yml -f docker-compose.app.yml down"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {}
}
