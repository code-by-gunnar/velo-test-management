NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=generate-with-openssl-rand-base64-32
INTERNAL_API_SECRET=same-value-as-api
# OAuth providers (Auth.js auto-detects AUTH_{PROVIDER}_{ID|SECRET})
# Google: Create at https://console.cloud.google.com/apis/credentials
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub: Create at https://github.com/settings/developers
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
API_URL=http://localhost:3001
# Browser-facing API base (SSE + docs display) — note: NEXT_PUBLIC_API_BASE_URL,
# not NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
