DATABASE_URL=postgresql://velo:velo@localhost:5432/velo_dev
VALKEY_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
AUTH_SECRET=same-value-as-web
INTERNAL_API_SECRET=same-value-as-web
WEB_URL=http://localhost:3000
# Email (optional) — no SMTP = console mode (OTPs/reset links print to stdout,
# invite links surface in the members UI). Any SMTP provider works.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=Velo <velo@yourdomain>
# SUPPORT_EMAIL=                 # reply-to on the welcome email
# Optional
# ENCRYPTION_KEY=64-hex-chars    # openssl rand -hex 32 — Linear token encryption
# SENTRY_DSN=                    # empty = Sentry disabled
